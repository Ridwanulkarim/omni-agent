# ================================================================
# OmniAgent Configuration: 100% FREE OPTIONS (No Billing Required)
# ================================================================

# --- OPTION 1: Google Gemini (FREE, NO credit card needed) ---
# Get your free key at: https://aistudio.google.com/app/apikey
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-3.6-flash
GEMINI_API_KEY=your_gemini_api_key_here

# --- OPTION 2: Groq (FREE, ultra-fast, NO credit card needed) ---
# Get your free key at: https://console.groq.com/keys
# DEFAULT_PROVIDER=groq
# DEFAULT_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=gsk_your_groq_key_here

# --- OPTION 3: GitHub Models (FREE with standard GitHub account) ---
# Create a free personal access token at: https://github.com/settings/tokens
# DEFAULT_PROVIDER=github
# DEFAULT_MODEL=gpt-4o-mini
# GITHUB_TOKEN=ghp_your_github_token_here

# --- OPTION 4: Ollama (100% OFFLINE & LOCAL, ZERO keys, ZERO billing) ---
# Install Ollama from https://ollama.com and run: ollama run llama3.2
# DEFAULT_PROVIDER=ollama
# DEFAULT_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# ================================================================
# Agent Runtime Controls
# ================================================================
MAX_STEPS=15
TOOL_TIMEOUT_SECONDS=60
WORKSPACE_DIR=./workspace
